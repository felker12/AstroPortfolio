---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { skillGroups } from "@data/pages/Skills";
---

<Layout
  title='Technical Skills | Kevin "Anthony" Felker'
  description="Explore Kevin Anthony Felker's technical skills, including C#, TypeScript, JavaScript, ASP.NET Core, Astro, React, .NET Aspire, SQL Server, PostgreSQL, Azure, GitHub Actions, and full-stack software development."
  canonical="https://anthonyfelker.com/skills"
  keywords={[
    "Kevin Anthony Felker skills",
    "Anthony Felker technical skills",
    "C# Developer",
    "ASP.NET Core Developer",
    "React Developer",
    "TypeScript Developer",
    "Astro Developer",
    ".NET Aspire",
    "Tailwind CSS",
    "SQL Server",
    "PostgreSQL",
    "Azure App Services",
    "GitHub Actions",
    "Full Stack Developer",
    "Software Engineer Skills",
  ]}
>
  <!-- Page introduction -->
  <section
    class="relative mx-auto flex min-h-[72svh] max-w-375 items-center
      px-4 py-28 sm:px-[clamp(1.25rem,6vw,7rem)]

      before:absolute before:bottom-[12%] before:left-3 before:top-[12%]
      before:w-px before:bg-linear-to-b before:from-transparent
      before:via-ice-100/20 before:to-transparent before:content-['']
      sm:before:left-[clamp(0.75rem,3vw,2rem)]"
  >
    <div class="relative z-3 w-full max-w-220">
      <p
        class="mb-4 font-mono text-sm tracking-[0.12em] text-ice-400
          before:mr-1 before:text-ice-800 before:content-['<']
          after:ml-1 after:text-ice-800 after:content-['/>']"
      >
        Technical skills
      </p>

      <h1
        class="m-0 max-w-[15ch] text-balance font-display
          text-[clamp(2.8rem,7vw,6rem)] font-extrabold leading-[0.98]
          tracking-[-0.055em] text-ink"
      >
        A practical toolkit for
        <span
          class="ml-[0.22em] text-ice-400
            drop-shadow-[0_0_28px_rgba(67,199,255,0.28)]"
        >
          modern software.
        </span>
      </h1>

      <p
        class="mt-6 max-w-[62ch]
          text-[clamp(1rem,1.8vw,1.18rem)]
          leading-relaxed text-ink-dim"
      >
        My technical experience spans full-stack .NET development, production
        websites, relational databases, cloud deployment, testing, and the
        operational tools required to keep software working after release.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/projects"
          class="inline-flex min-h-12 items-center justify-center gap-2.5
            rounded-xl border border-ice-300/50
            bg-linear-to-br from-[rgba(21,133,190,0.82)]
            to-[rgba(23,92,135,0.72)] px-5
            font-mono text-sm font-semibold tracking-wide
            text-ice-50 no-underline
            shadow-[0_0_32px_rgba(42,178,255,0.2)]
            transition-all duration-150
            hover:-translate-y-0.5 hover:border-ice-200
            hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
        >
          View projects
        </a>

        <a
          href="/Resume.pdf"
          download="Anthony-Felker-Resume.pdf"
          class="inline-flex min-h-12 items-center justify-center
            rounded-xl border border-ice-100/20
            bg-[rgba(4,25,42,0.52)] px-5
            font-mono text-sm font-semibold tracking-wide
            text-ice-200 no-underline backdrop-blur-md
            transition-all duration-150
            hover:-translate-y-0.5 hover:border-ice-300/50
            hover:bg-[rgba(8,48,75,0.66)] hover:text-ice-50"
        >
          Download resume
        </a>
      </div>
    </div>
  </section>

  <!-- Skills overview -->
  <section
    class="reveal-target relative mx-auto max-w-375
      px-4 py-24 sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div class="reveal relative z-3">
      <div class="mb-10 max-w-190">
        <p
          class="mb-3 font-mono text-xs tracking-[0.12em]
            text-ice-400 before:text-ice-800 before:content-['//_']"
        >
          Engineering toolkit
        </p>

        <h2
          class="font-display text-[clamp(2rem,5vw,3.5rem)]
            font-bold leading-[1.08] tracking-[-0.04em] text-ink"
        >
          Technologies selected for
          <span class="ml-[0.22em] text-ice-400">real project needs.</span>
        </h2>

        <p class="mt-5 max-w-[60ch] leading-relaxed text-ink-dim">
          I focus on tools that help me build maintainable applications,
          dependable APIs, responsive interfaces, and production systems that
          can be deployed and supported with confidence.
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        {
          skillGroups.map((group) => (
            <article
              class="panel-tilt pointer-glow relative overflow-hidden
                rounded-2xl border border-ice-100/10 p-6
                bg-[linear-gradient(145deg,rgba(23,98,139,0.13),rgba(3,18,31,0.62))]
                shadow-[inset_0_1px_0_rgba(222,247,255,0.04),0_18px_45px_rgba(0,7,14,0.24)]
                backdrop-blur-xl transition-all duration-200

                hover:border-ice-300/30
                hover:shadow-[inset_0_1px_0_rgba(222,247,255,0.06),0_22px_52px_rgba(0,7,14,0.34)]

                before:absolute before:left-6 before:top-0
                before:h-px before:w-16 before:bg-ice-400
                before:shadow-[0_0_12px_rgba(67,199,255,0.7)]
                before:content-['']"
            >
              <header class="mb-5 flex items-start justify-between gap-5">
                <div class="flex items-center gap-4">
                  <div
                    class="flex h-11 w-11 shrink-0 items-center justify-center
                      rounded-xl border border-ice-100/10
                      bg-[rgba(7,40,63,0.68)] text-ice-400
                      shadow-[inset_0_1px_0_rgba(222,247,255,0.05)]"
                  >
                    <Icon name={group.icon} class="h-6 w-6" />
                  </div>

                  <h3 class="font-display text-xl font-semibold text-ink">
                    {group.category}
                  </h3>
                </div>

                <span
                  class="font-mono text-xs tracking-wider text-ice-700"
                  aria-hidden="true"
                >
                  {group.number}
                </span>
              </header>

              <p class="mb-6 max-w-[58ch] text-sm leading-relaxed text-ink-dim">
                {group.description}
              </p>

              <ul class="flex list-none flex-wrap gap-2 p-0">
                {
                  group.skills.map((skill) => (
                    <li
                      class="tech-tag rounded-md border border-ice-100/10
                        bg-[rgba(5,29,47,0.58)] px-3 py-1.5
                        font-mono text-xs tracking-wide text-ice-200
                        transition-all duration-150

                        [&.is-active]:-translate-y-0.5
                        [&.is-active]:border-ice-300/50
                        [&.is-active]:bg-[rgba(9,60,92,0.68)]
                        [&.is-active]:text-ice-50
                        [&.is-active]:shadow-[0_0_18px_rgba(67,199,255,0.12)]"
                    >
                      {skill}
                    </li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Supporting strengths -->
  <section
    class="reveal-target relative mx-auto max-w-375
      px-4 py-24 sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div
      class="reveal pointer-glow relative z-3 overflow-hidden
        rounded-2xl border border-ice-100/10 p-6
        bg-[linear-gradient(135deg,rgba(18,76,111,0.12),transparent_48%),rgba(3,19,32,0.68)]
        shadow-[inset_0_1px_0_rgba(222,247,255,0.06),0_24px_70px_rgba(0,7,14,0.38)]
        backdrop-blur-xl md:p-10

        before:absolute before:-top-px before:left-8
        before:h-px before:w-24 before:bg-linear-to-r
        before:from-transparent before:via-ice-400 before:to-transparent
        before:shadow-[0_0_14px_rgba(67,199,255,0.72)]
        before:content-['']"
    >
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-14">
        <div>
          <p
            class="mb-3 font-mono text-xs tracking-[0.12em]
              text-ice-400 before:text-ice-800 before:content-['//_']"
          >
            Beyond the stack
          </p>

          <h2
            class="font-display text-[clamp(2rem,4vw,3.25rem)]
              font-bold leading-[1.05] tracking-[-0.04em] text-ink"
          >
            Technical skills supported by
            <span class="ml-[0.22em] text-ice-400">production experience.</span>
          </h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <article
            class="rounded-xl border border-ice-100/10
              bg-[rgba(3,20,34,0.56)] p-5"
          >
            <h3 class="mb-2 font-display text-lg font-semibold text-ink">
              Deployment ownership
            </h3>

            <p class="text-sm leading-relaxed text-ink-dim">
              Experience managing repositories, build pipelines, hosting,
              domains, DNS, releases, and ongoing production updates.
            </p>
          </article>

          <article
            class="rounded-xl border border-ice-100/10
              bg-[rgba(3,20,34,0.56)] p-5"
          >
            <h3 class="mb-2 font-display text-lg font-semibold text-ink">
              Debugging and support
            </h3>

            <p class="text-sm leading-relaxed text-ink-dim">
              Years of diagnosing software, hardware, networking, and
              integration issues in business-critical environments.
            </p>
          </article>

          <article
            class="rounded-xl border border-ice-100/10
              bg-[rgba(3,20,34,0.56)] p-5"
          >
            <h3 class="mb-2 font-display text-lg font-semibold text-ink">
              Performance and quality
            </h3>

            <p class="text-sm leading-relaxed text-ink-dim">
              Focused on testing, responsive design, accessibility, SEO,
              maintainability, and measurable Lighthouse improvements.
            </p>
          </article>

          <article
            class="rounded-xl border border-ice-100/10
              bg-[rgba(3,20,34,0.56)] p-5"
          >
            <h3 class="mb-2 font-display text-lg font-semibold text-ink">
              Business collaboration
            </h3>

            <p class="text-sm leading-relaxed text-ink-dim">
              Comfortable gathering requirements, translating feedback, and
              explaining technical decisions to non-technical stakeholders.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section
    class="reveal-target relative flex min-h-[70svh] items-center
      justify-center px-4 py-28 text-center
      sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div class="reveal relative z-3 w-full max-w-170">
      <p
        class="mb-3 font-mono text-xs tracking-[0.13em]
          text-ice-400 before:text-ice-800 before:content-['//_']"
      >
        Skills in practice
      </p>

      <h2
        class="mb-5 font-display text-[clamp(2rem,5vw,3.5rem)]
          font-bold leading-[1.08] tracking-[-0.04em] text-ink"
      >
        See how these technologies become
        <span class="ml-[0.22em] text-ice-400">working systems.</span>
      </h2>

      <p
        class="mx-auto mb-7 max-w-[54ch]
          text-[clamp(0.98rem,1.5vw,1.08rem)] text-ink-dim"
      >
        Browse production websites, full-stack applications, APIs, and
        engineering projects built with this toolkit.
      </p>

      <a
        href="/projects"
        class="inline-flex min-h-12 items-center justify-center gap-2.5
          rounded-xl border border-ice-300/50
          bg-linear-to-br from-[rgba(21,133,190,0.82)]
          to-[rgba(23,92,135,0.72)] px-5
          font-mono text-sm font-semibold tracking-wide
          text-ice-50 no-underline
          shadow-[0_0_32px_rgba(42,178,255,0.2)]
          transition-all duration-150
          hover:-translate-y-0.5 hover:border-ice-200
          hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
      >
        Explore my projects
      </a>
    </div>
  </section>
</Layout>