---
import Layout from '@layouts/Layout.astro'; 
import BackgroundCanvas from "@components/BackgroundCanvas.astro";
import { personSchema } from '@data/seo/person';
import { websiteSchema, } from '@data/pages/index';
import Hero from '@components/Hero.astro';
import StatsGrid from '@components/StatsGrid.astro';
import SectionCard from '@components/SectionCard.astro';
import { highlights } from '@data/components/HomepageHighlights'
import { stats } from '@data/components/Stats'
import CTA from '@components/CTA.astro';
---

<Layout
  title='Kevin "Anthony" Felker | Full-Stack Developer'
  description='Portfolio of Kevin "Anthony" Felker, a full-stack developer based in Indiana with experience in C#, ASP.NET Core, React, Astro, SQL Server, Azure, GitHub Actions, and production website development.'
  canonical='https://anthonyfelker.com/'
  schema={[personSchema, websiteSchema]}
>
  <BackgroundCanvas mode="hero" />

  <Hero />

  {
    highlights.map((highlight) => (
      <SectionCard {...highlight} />
    ))
  }

  <StatsGrid {stats} />

  <CTA />
</Layout>