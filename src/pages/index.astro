---
import Layout from '@layouts/Layout.astro'; 
import Footer from '@components/Footer.astro';
import { personSchema } from '@data/seo/person';

interface linkItem {
  title: string;
  link: string;
}

interface displayItem {
  title: string;
  text: string;
  linkItem: linkItem;
}

const displayItems: Array<displayItem> = [
  {
    title: "About Me",
    text: "I'm a passionate developer with expertise in web development, software engineering, and problem-solving.",
    linkItem: {
      title: "Learn About Me",
      link: "/about",
    },
  },
  {
    title: "Projects",
    text: "Check out my latest projects and see how I can help you achieve their goals.",
    linkItem: {
      title: "View Projects",
      link: "/projects",
    },
  },
  {
    title: "Contact",
    text: "Let's connect! I'm always open to discussing new projects and opportunities.",
    linkItem: {
      title: "Contact Me",
      link: "/contact",
    },
  }
];

export const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kevin Anthony Felker Portfolio",
  url: "https://anthonyfelker.com"
};
---

<Layout
  title='Kevin "Anthony" Felker | Full-Stack Developer'
  description='Portfolio of Kevin "Anthony" Felker, a full-stack developer based in Indiana with experience in C#, ASP.NET Core, React, Astro, SQL Server, Azure, GitHub Actions, and production website development.'
  canonical='https://anthonyfelker.com/'
  schema={[personSchema, websiteSchema]}
>
    <div class="max-w-7xl mx-auto px-4 py-16 md:py-24 text-center">
        <h1 class="text-5xl md:text-6xl font-light text-white mb-4 tracking-tight">
            Kevin "Anthony" Felker
        </h1> 

        <h2 class="text-xl md:text-2xl font-light text-slate-400 mb-16">
            Full-Stack Developer | Web Developer | Software Engineer
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left mx-auto px-2">
        {
            displayItems.map((item) => (
                <div class="flex flex-col bg-black/50 border border-slate-800/90
                shadow-lg p-6 rounded-xl justify-between hover:border-slate-700/50 hover:-translate-y-1
                transition-all duration-300 ease-out backdrop-blur-sm">
                    <div>
                        <h3 class="text-xl font-semibold text-white mb-3">{item.title}</h3>
                        <p class="text-slate-400 text-sm leading-relaxed mb-6">{item.text}</p>
                    </div>
                    <a 
                      href={item.linkItem.link} 
                      class="inline-block bg-cyan-700 hover:bg-cyan-600
                      text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:scale-105
                      transition-all duration-300 self-center text-center shadow-md shadow-cyan-950/20
                      focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
                    >
                      {item.linkItem.title}
                  </a>
                </div>
            ))
        }
        </div>
        <Footer />
    </div>
</Layout>