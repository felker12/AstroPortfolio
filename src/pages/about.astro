---
import Layout from "@layouts/Layout.astro";
import { personSchema } from "@data/seo/person";
import { skillCategories, experience } from "@data/pages/About"
---

<Layout
  title='About Kevin "Anthony" Felker | Full-Stack Software Engineer'
  description="Learn about Kevin Anthony Felker, a full-stack software engineer and web developer experienced with C#, ASP.NET Core, React, Astro, SQL Server, Azure, GitHub Actions, and production website development."
  canonical="https://anthonyfelker.com/about"
  keywords={[
    "Kevin Anthony Felker",
    "Anthony Felker",
    "Full Stack Developer",
    "Software Engineer",
    "Web Developer",
    "C# Developer",
    "ASP.NET Core",
    "React Developer",
    "Astro Developer",
    "SQL Server",
    "Azure",
    "Indiana Software Engineer",
    "Terre Haute Web Developer",
  ]}
  schema={personSchema}
>
  <!-- Page introduction -->
  <section
    class="relative mx-auto flex min-h-[72svh] max-w-375 items-center
      px-4 py-28 sm:px-[clamp(1.25rem,6vw,7rem)]

      before:absolute before:bottom-[12%] before:left-3 before:top-[12%]
      before:w-px before:bg-linear-to-b before:from-transparent
      before:via-ice-100/20 before:to-transparent before:content-['']
      sm:before:left-[clamp(0.75rem,3vw,2rem)]"
  >
    <div class="relative z-3 w-full max-w-220">
      <p
        class="mb-4 font-mono text-sm tracking-[0.12em] text-ice-400
          before:mr-1 before:text-ice-800 before:content-['<']
          after:ml-1 after:text-ice-800 after:content-['/>']"
      >
        About me
      </p>

      <h1
        class="m-0 max-w-[15ch] text-balance font-display
          text-[clamp(2.8rem,7vw,6rem)] font-extrabold leading-[0.98]
          tracking-[-0.055em] text-ink"
      >
        Engineering experience shaped by
        <span
          class="ml-[0.22em] text-ice-400
            drop-shadow-[0_0_28px_rgba(67,199,255,0.28)]"
        >
          real systems.
        </span>
      </h1>

      <p
        class="mt-6 max-w-[62ch]
            text-[clamp(1rem,1.8vw,1.18rem)]
            leading-relaxed text-ink-dim"
        >
        I'm a software engineer and web developer with professional experience
        delivering production websites, building full-stack .NET applications,
        developing APIs, and supporting business-critical technology. That
        combination has taught me to value maintainable code, clear communication,
        and systems designed to perform reliably beyond the initial release.
    </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/projects"
          class="inline-flex min-h-12 items-center justify-center gap-2.5
            rounded-xl border border-ice-300/50
            bg-linear-to-br from-[rgba(21,133,190,0.82)]
            to-[rgba(23,92,135,0.72)] px-5
            font-mono text-sm font-semibold tracking-wide text-ice-50
            no-underline shadow-[0_0_32px_rgba(42,178,255,0.2)]
            transition-all duration-150
            hover:-translate-y-0.5 hover:border-ice-200
            hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
        >
          View my work
        </a>

        <a
          href="/Resume.pdf"
          download="Anthony-Felker-Resume.pdf"
          class="inline-flex min-h-12 items-center justify-center
            rounded-xl border border-ice-100/20
            bg-[rgba(4,25,42,0.52)] px-5
            font-mono text-sm font-semibold tracking-wide
            text-ice-200 no-underline backdrop-blur-md
            transition-all duration-150
            hover:-translate-y-0.5 hover:border-ice-300/50
            hover:bg-[rgba(8,48,75,0.66)] hover:text-ice-50"
        >
          Download resume
        </a>
      </div>
    </div>
  </section>

  <!-- Professional summary -->
  <section
    class="reveal-target relative mx-auto max-w-375
      px-4 py-24 sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div
      class="reveal pointer-glow relative z-3 overflow-hidden rounded-2xl
        border border-ice-100/10 p-6
        bg-[linear-gradient(135deg,rgba(18,76,111,0.12),transparent_48%),rgba(3,19,32,0.68)]
        shadow-[inset_0_1px_0_rgba(222,247,255,0.06),0_24px_70px_rgba(0,7,14,0.38)]
        backdrop-blur-xl md:p-10

        before:absolute before:-top-px before:left-8 before:h-px before:w-24
        before:bg-linear-to-r before:from-transparent before:via-ice-400
        before:to-transparent
        before:shadow-[0_0_14px_rgba(67,199,255,0.72)]
        before:content-['']"
    >
      <div class="grid gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-14">
        <div>
          <p
            class="mb-3 font-mono text-xs tracking-[0.12em]
              text-ice-400 before:text-ice-800 before:content-['//_']"
          >
            01 · Professional summary
          </p>

          <h2
            class="font-display text-[clamp(2rem,4vw,3.25rem)]
              font-bold leading-[1.05] tracking-[-0.04em] text-ink"
          >
            Building software with a 
            <span class="ml-[0.22em] text-ice-400">production mindset.</span>
          </h2>
        </div>

        <div class="space-y-5 text-[1rem] leading-relaxed text-ink-dim">
            <p>
                I'm a software engineer with professional experience developing and
                maintaining production websites and building full-stack .NET applications.
                My work includes ASP.NET Core, C#, Astro, React, SQL Server, Azure,
                GitHub Actions, and modern CI/CD workflows.
            </p>

            <p>
                I bring a strong foundation in object-oriented design, REST APIs,
                debugging, testing, and scalable software architecture. My background
                supporting business-critical systems also shapes how I work: investigate
                carefully, communicate clearly, test assumptions, and build solutions that
                remain understandable and dependable after release.
            </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical expertise -->
  <section
    class="reveal-target relative mx-auto max-w-375
      px-4 py-24 sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div class="reveal relative z-3">
      <div class="mb-10 max-w-190">
        <p
          class="mb-3 font-mono text-xs tracking-[0.12em]
            text-ice-400 before:text-ice-800 before:content-['//_']"
        >
          02 · Technical expertise
        </p>

        <h2
          class="font-display text-[clamp(2rem,5vw,3.5rem)]
            font-bold leading-[1.08] tracking-[-0.04em] text-ink"
        >
          Tools chosen for
          <span class="ml-[0.22em] text-ice-400">practical results.</span>
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {
          skillCategories.map((category) => (
            <article
              class="panel-tilt pointer-glow relative overflow-hidden
                rounded-2xl border border-ice-100/10 p-6
                bg-[linear-gradient(145deg,rgba(23,98,139,0.13),rgba(3,18,31,0.58))]
                shadow-[inset_0_1px_0_rgba(222,247,255,0.04),0_18px_45px_rgba(0,7,14,0.24)]
                backdrop-blur-xl transition-all duration-200

                hover:border-ice-300/30
                hover:shadow-[inset_0_1px_0_rgba(222,247,255,0.06),0_22px_52px_rgba(0,7,14,0.34)]

                before:absolute before:left-6 before:top-0 before:h-px
                before:w-16 before:bg-ice-400
                before:shadow-[0_0_12px_rgba(67,199,255,0.7)]
                before:content-['']"
            >
              <div class="mb-4 flex items-center justify-between gap-4">
                <h3 class="font-display text-xl font-semibold text-ink">
                  {category.title}
                </h3>

                <span
                  class="font-mono text-xs tracking-wider text-ice-700"
                  aria-hidden="true"
                >
                  {category.number}
                </span>
              </div>

              <p class="mb-5 max-w-[54ch] text-sm leading-relaxed text-ink-dim">
                {category.description}
              </p>

              <ul class="flex list-none flex-wrap gap-2 p-0">
                {
                  category.skills.map((skill) => (
                    <li
                      class="rounded-md border border-ice-100/10
                        bg-[rgba(5,29,47,0.58)] px-2.5 py-1.5
                        font-mono text-xs tracking-wide text-ice-200"
                    >
                      {skill}
                    </li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section
    class="reveal-target relative mx-auto max-w-375
      px-4 py-24 sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div class="reveal relative z-3">
      <div class="mb-10 max-w-190">
        <p
          class="mb-3 font-mono text-xs tracking-[0.12em]
            text-ice-400 before:text-ice-800 before:content-['//_']"
        >
          03 · Professional experience
        </p>

        <h2
          class="font-display text-[clamp(2rem,5vw,3.5rem)]
            font-bold leading-[1.08] tracking-[-0.04em] text-ink"
        >
          Experience across development and
          <span class="ml-[0.22em] text-ice-400">technical operations.</span>
        </h2>
      </div>

      <div
        class="relative space-y-8
          before:absolute before:bottom-0 before:left-[0.45rem] before:top-0
          before:w-px before:bg-linear-to-b before:from-ice-400/50
          before:via-ice-100/15 before:to-transparent
          before:content-['']"
      >
        {
          experience.map((job) => (
            <article class="group relative pl-10">
              <span
                class:list={[
                  `absolute left-0 top-8 h-4 w-4 rounded-full border-4
                  border-bg-deep transition-all duration-200
                  group-hover:scale-125`,
                  job.current
                    ? `bg-ice-400 shadow-[0_0_14px_rgba(67,199,255,0.72)]`
                    : `bg-ice-800 group-hover:bg-ice-500`,
                ]}
              ></span>

              <div
                class="pointer-glow relative overflow-hidden rounded-2xl
                  border border-ice-100/10 p-6
                  bg-[linear-gradient(135deg,rgba(18,76,111,0.1),transparent_50%),rgba(3,19,32,0.7)]
                  shadow-[inset_0_1px_0_rgba(222,247,255,0.05),0_24px_60px_rgba(0,7,14,0.28)]
                  backdrop-blur-xl md:p-8

                  before:absolute before:-top-px before:left-8 before:h-px
                  before:w-20 before:bg-linear-to-r before:from-transparent
                  before:via-ice-400 before:to-transparent
                  before:shadow-[0_0_14px_rgba(67,199,255,0.6)]
                  before:content-['']"
              >
                <header
                  class="mb-6 flex flex-col gap-3
                    sm:flex-row sm:items-start sm:justify-between"
                >
                  <div>
                    <h3 class="font-display text-xl font-semibold text-ink">
                      {job.role}
                    </h3>

                    <p class="mt-1 text-sm text-ink-dim">
                      {job.company} · {job.location}
                    </p>
                  </div>

                  <span
                    class:list={[
                      `self-start rounded-full border px-3 py-1
                      font-mono text-xs tracking-wide`,
                      job.current
                        ? `border-ice-300/30 bg-ice-400/10 text-ice-300`
                        : `border-ice-100/10 bg-[rgba(4,25,42,0.55)] text-ink-dim`,
                    ]}
                  >
                    {job.period}
                  </span>
                </header>

                <ul class="space-y-3 text-sm leading-relaxed text-ink-dim">
                  {
                    job.bullets.map((bullet) => (
                      <li class="relative pl-5 before:absolute before:left-0 before:top-[0.65em] before:h-1 before:w-1 before:rounded-full before:bg-ice-400 before:shadow-[0_0_7px_rgba(67,199,255,0.7)] before:content-['']">
                        {bullet}
                      </li>
                    ))
                  }
                </ul>

                {
                  job.projects && (
                    <div class="mt-7 border-t border-ice-100/10 pt-6">
                      <p
                        class="mb-4 font-mono text-[0.66rem]
                          tracking-[0.12em] text-ice-400"
                      >
                        Production deployments
                      </p>

                      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                        {
                          job.projects.map((project) => (
                            <a
                                href={project.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group/project flex flex-col rounded-xl border
                                    border-ice-100/10 bg-[rgba(3,20,34,0.58)] p-4
                                    no-underline transition-all duration-200
                                    hover:-translate-y-0.5 hover:border-ice-300/30
                                    hover:bg-[rgba(7,40,63,0.72)]"
                                >
                                <span
                                    class="block text-sm font-semibold text-ink-soft
                                    transition-colors duration-200
                                    group-hover/project:text-ice-50"
                                >
                                    {project.name}
                                </span>

                                <span class="mt-1.5 block font-mono text-[0.65rem] text-ice-300">
                                    {project.stack}
                                </span>

                                <span class="mt-3 block text-xs leading-relaxed text-ink-dim">
                                    {project.description}
                                </span>
                            </a>
                          ))
                        }
                      </div>
                    </div>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Education -->
  <section
    class="reveal-target relative mx-auto max-w-375
      px-4 py-24 sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div class="reveal relative z-3">
      <div class="mb-10 max-w-190">
        <p
          class="mb-3 font-mono text-xs tracking-[0.12em]
            text-ice-400 before:text-ice-800 before:content-['//_']"
        >
          04 · Education
        </p>

        <h2
          class="font-display text-[clamp(2rem,5vw,3.5rem)]
            font-bold leading-[1.08] tracking-[-0.04em] text-ink"
        >
          A foundation in
          <span class="ml-[0.22em] text-ice-400">information systems.</span>
        </h2>
      </div>

      <article
        class="pointer-glow relative flex flex-col gap-6 overflow-hidden
          rounded-2xl border border-ice-100/10 p-6
          bg-[linear-gradient(135deg,rgba(18,76,111,0.11),transparent_50%),rgba(3,19,32,0.7)]
          shadow-[inset_0_1px_0_rgba(222,247,255,0.05),0_24px_60px_rgba(0,7,14,0.28)]
          backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between
          md:p-8

          before:absolute before:-top-px before:left-8 before:h-px
          before:w-20 before:bg-linear-to-r before:from-transparent
          before:via-ice-400 before:to-transparent
          before:shadow-[0_0_14px_rgba(67,199,255,0.6)]
          before:content-['']"
      >
        <div>
          <h3 class="font-display text-xl font-semibold text-ink">
            Bachelor of Science in Computer Information Systems
          </h3>

          <p class="mt-2 text-sm text-ink-dim">
            DeVry University · Federal Way, WA
          </p>
        </div>

        <div
          class="min-w-26 rounded-xl border border-ice-100/10
            bg-[rgba(7,40,63,0.68)] px-5 py-3 text-center"
        >
          <p
            class="font-mono text-[0.62rem]
              tracking-[0.12em] text-ink-dim"
          >
            GPA
          </p>

          <p class="font-display text-2xl font-bold text-ice-300">
            3.76
          </p>
        </div>
      </article>
    </div>
  </section>

  <!-- Closing CTA -->
  <section
    class="reveal-target relative flex min-h-[70svh] items-center
      justify-center px-4 py-28 text-center
      sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div class="reveal relative z-3 w-full max-w-170">
      <p
        class="mb-3 font-mono text-xs tracking-[0.13em]
          text-ice-400 before:text-ice-800 before:content-['//_']"
      >
        Explore my work
      </p>

      <h2
        class="mb-5 font-display text-[clamp(2rem,5vw,3.5rem)]
          font-bold leading-[1.08] tracking-[-0.04em] text-ink"
      >
        See how that experience becomes
        <span class="ml-[0.22em] text-ice-400">working software.</span>
      </h2>

      <p
        class="mx-auto mb-7 max-w-[54ch]
          text-[clamp(0.98rem,1.5vw,1.08rem)] text-ink-dim"
      >
        Browse production websites, full-stack applications, and technical
        projects built to solve practical problems.
      </p>

      <a
        href="/projects"
        class="inline-flex min-h-12 items-center justify-center gap-2.5
          rounded-xl border border-ice-300/50
          bg-linear-to-br from-[rgba(21,133,190,0.82)]
          to-[rgba(23,92,135,0.72)] px-5
          font-mono text-sm font-semibold tracking-wide
          text-ice-50 no-underline
          shadow-[0_0_32px_rgba(42,178,255,0.2)]
          transition-all duration-150
          hover:-translate-y-0.5 hover:border-ice-200
          hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
      >
        View my projects
      </a>
    </div>
  </section>
</Layout>