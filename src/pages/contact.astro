---
import Layout from "@layouts/Layout.astro";
import ContactForm from "@components/ContactForm.astro";
import ContactInfo from "@components/ContactInfo.astro";

import { personSchema } from "@data/seo/person";
import { ContactInfoData } from "@data/components/ContactInfo";
---

<Layout
  title='Contact Kevin "Anthony" Felker | Full-Stack Developer'
  description="Contact Kevin Anthony Felker about software engineering opportunities, production websites, full-stack development, or technical projects."
  canonical="https://anthonyfelker.com/contact"
  keywords={[
    "Contact Kevin Anthony Felker",
    "Anthony Felker contact",
    "Full Stack Developer Indiana",
    "Web Developer Terre Haute",
    "C# Developer",
    "ASP.NET Core Developer",
    "Software Engineer Indiana",
  ]}
  schema={personSchema}
>
  <section
    class="reveal-target relative mx-auto flex min-h-svh
      max-w-375 items-center px-4 py-28
      sm:px-[clamp(1.25rem,6vw,7rem)]

      before:absolute before:bottom-[10%] before:left-3 before:top-[10%]
      before:w-px before:bg-linear-to-b before:from-transparent
      before:via-ice-100/20 before:to-transparent before:content-['']
      sm:before:left-[clamp(0.75rem,3vw,2rem)]"
  >
    <div class="reveal relative z-3 w-full">
      <!-- Page heading -->
      <div class="mb-14 max-w-190">
        <p
          class="mb-4 font-mono text-sm tracking-[0.12em]
            text-ice-400 before:mr-1 before:text-ice-800
            before:content-['<']
            after:ml-1 after:text-ice-800 after:content-['/>']"
        >
          Contact
        </p>

        <h1
          class="m-0 max-w-[14ch] text-balance font-display
            text-[clamp(2.8rem,7vw,6rem)] font-extrabold
            leading-[0.98] tracking-[-0.055em] text-ink"
        >
          Let's start a&nbsp;
          <span
            class="text-ice-400
              drop-shadow-[0_0_28px_rgba(67,199,255,0.28)]"
          >
            conversation.
          </span>
        </h1>

        <p
          class="mt-6 max-w-[58ch]
            text-[clamp(1rem,1.8vw,1.18rem)]
            leading-relaxed text-ink-dim"
        >
          Reach out about a software engineering opportunity, a production
          website, or a technical project that needs a dependable path forward.
        </p>
      </div>

      <!-- Contact layout -->
      <div
        class="grid grid-cols-1 items-start gap-6
          lg:grid-cols-12 lg:gap-8"
      >
        <!-- Quick connections -->
        <aside class="space-y-4 lg:col-span-5">
          <div
            class="pointer-glow relative overflow-hidden rounded-2xl
              border border-ice-100/10 p-6
              bg-[linear-gradient(135deg,rgba(18,76,111,0.12),transparent_50%),rgba(3,19,32,0.7)]
              shadow-[inset_0_1px_0_rgba(222,247,255,0.05),0_24px_70px_rgba(0,7,14,0.3)]
              backdrop-blur-xl

              before:absolute before:-top-px before:left-8
              before:h-px before:w-20 before:bg-linear-to-r
              before:from-transparent before:via-ice-400
              before:to-transparent
              before:shadow-[0_0_14px_rgba(67,199,255,0.72)]
              before:content-['']"
          >
            <p
              class="mb-3 font-mono text-xs tracking-[0.12em]
                text-ice-400 before:text-ice-800 before:content-['//_']"
            >
              Direct routing
            </p>

            <h2
              class="mb-3 font-display text-2xl font-semibold
                tracking-tight text-ink"
            >
              Choose a connection
            </h2>

            <p class="text-sm leading-relaxed text-ink-dim">
              Use the form for opportunities and project inquiries, or connect
              through one of the professional channels below.
            </p>
          </div>

          <div class="space-y-3">
            {
              ContactInfoData.map((contact) => (
                <ContactInfo {...contact} />
              ))
            }
          </div>
        </aside>

        <!-- Contact form -->
        <div
          class="pointer-glow relative overflow-hidden rounded-2xl
            border border-ice-100/10 p-6
            bg-[linear-gradient(135deg,rgba(18,76,111,0.12),transparent_48%),rgba(3,19,32,0.72)]
            shadow-[inset_0_1px_0_rgba(222,247,255,0.06),0_24px_70px_rgba(0,7,14,0.38)]
            backdrop-blur-xl md:p-8 lg:col-span-7

            before:absolute before:-top-px before:left-8
            before:h-px before:w-24 before:bg-linear-to-r
            before:from-transparent before:via-ice-400
            before:to-transparent
            before:shadow-[0_0_14px_rgba(67,199,255,0.72)]
            before:content-['']"
        >
          <div class="mb-7">
            <p
              class="mb-2 font-mono text-xs tracking-[0.12em]
                text-ice-400 before:text-ice-800 before:content-['//_']"
            >
              Message gateway
            </p>

            <h2
              class="font-display text-2xl font-semibold
                tracking-tight text-ink"
            >
              Send a message
            </h2>
          </div>

          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>