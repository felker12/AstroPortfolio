---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import ProjectHero from "@components/ProjectComponents/ProjectHero.astro";
import ProjectShowcase from "@components/ProjectComponents/ProjectShowcase.astro";
import ProjectSplitSection from "@components/ProjectComponents/ProjectSplitSection.astro";
import ProjectFlow from "@components/ProjectComponents/ProjectFlow.astro";
import ProjectGallery from "@components/ProjectComponents/ProjectGallery.astro";
import ProjectFeatureGrid from "@components/ProjectComponents/ProjectFeatureGrid.astro";

import {
  hero,
  features,
  flow,
  technicalHighlights,
  challenges,
  futureImprovements,
  visibleScreenshots,
} from "@data/projects/engine.ts";
---

<Layout
  title='Modular 2D RPG Engine | Kevin "Anthony" Felker'
  description="Case study for a custom 2D RPG engine built with C#, MonoGame, XML, WinForms tooling, and xUnit."
  canonical="https://anthonyfelker.com/projects/game-engine"
>
  <div class="mx-auto w-full max-w-375 px-4 sm:px-6 lg:px-8">
    <div class="relative z-3 pt-28">
      <a href="/projects" class="inline-flex items-center gap-2 font-mono text-xs tracking-wide text-ink-dim no-underline transition-colors duration-200 hover:text-ice-300">
        <Icon name="mdi:arrow-left" class="h-4 w-4" />
        Back to projects
      </a>
    </div>

    <ProjectHero {...hero} />

    <div id="game-engine-gallery">
      <ProjectShowcase screenshot={visibleScreenshots[0]} />

      <ProjectSplitSection title="Project overview" subtitle="Context & purpose" borderTop={false}>
        <div class="space-y-5 leading-relaxed text-ink-dim">
          <p>
            This project is a custom 2D RPG engine built to explore C# software architecture
            through rendering, input, state management, combat, animation, persistence, and tooling.
          </p>
          <p>
            The codebase grew beyond 10,000 lines and became a long-running exercise in modular design,
            refactoring, testing, and maintaining reusable systems across iterative development cycles.
          </p>
          <p>
            It also includes a WinForms editor that improved content creation efficiency and provided
            experience building tools around a larger application.
          </p>
        </div>
      </ProjectSplitSection>

      <ProjectFlow {...flow} />

      <ProjectFeatureGrid title="Key features" subtitle="Engine functionality" features={features} />

      <ProjectGallery screenshots={visibleScreenshots} />
    </div>

    <ProjectFeatureGrid title="Technical highlights" subtitle="Architecture & implementation" features={technicalHighlights} />

    <ProjectSplitSection title="Challenges & solutions" subtitle="Problem solving">
      <ul class="space-y-4 text-sm leading-relaxed text-ink-dim">
        {
          challenges.map((item) => (
            <li class="relative pl-5 before:absolute before:left-0 before:top-[0.68em] before:h-1 before:w-1 before:rounded-full before:bg-ice-400 before:shadow-[0_0_7px_rgba(67,199,255,0.7)] before:content-['']">
              <strong class="font-semibold text-ink-soft">{item.title}</strong> 
              {item.description}
            </li>
          ))
        }
      </ul>
    </ProjectSplitSection>

    <ProjectSplitSection title="Future improvements" subtitle="Planned enhancements">
      <ol class="grid list-none gap-3 p-0 sm:grid-cols-2">
        {
          futureImprovements.map((item, index) => (
            <li class="flex items-start gap-3 rounded-xl border border-ice-100/10 bg-[rgba(3,20,34,0.56)] p-4">
              <span class="shrink-0 font-mono text-xs tracking-wide text-ice-400">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="text-sm leading-relaxed text-ink-dim">{item}</span>
            </li>
          ))
        }
      </ol>
    </ProjectSplitSection>

    <section
      class="reveal-target relative flex min-h-[58svh]
        items-center justify-center py-24 text-center
        before:absolute before:inset-x-0 before:top-0 before:h-px
        before:bg-linear-to-r before:from-transparent
        before:via-ice-100/10 before:to-transparent before:content-['']"
    >
      <div class="reveal relative z-3 w-full max-w-170">
        <p
          class="mb-3 font-mono text-xs tracking-[0.13em]
            text-ice-400 before:text-ice-800 before:content-['//_']"
        >
          Continue exploring
        </p>

        <h2
          class="mb-5 font-display text-[clamp(2rem,5vw,3.5rem)]
            font-bold leading-[1.08] tracking-[-0.04em] text-ink"
        >
          Explore more
          <span class="ml-[0.22em] text-ice-400">engineering projects.</span>
        </h2>

        <p
          class="mx-auto mb-7 max-w-[54ch]
            text-[clamp(0.98rem,1.5vw,1.08rem)] text-ink-dim"
        >
          Browse additional full-stack applications, production websites, and
          software projects covering APIs, databases, testing, deployment, and
          maintainable system design.
        </p>

        <a
          href="/projects"
          class="inline-flex min-h-12 items-center justify-center gap-2.5
            rounded-xl border border-ice-300/50
            bg-linear-to-br from-[rgba(21,133,190,0.82)]
            to-[rgba(23,92,135,0.72)] px-5
            font-mono text-sm font-semibold tracking-wide
            text-ice-50 no-underline
            shadow-[0_0_32px_rgba(42,178,255,0.2)]
            transition-all duration-150
            hover:-translate-y-0.5 hover:border-ice-200
            hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
        >
          Back to projects
          <Icon name="mdi:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </section>

  </div>
</Layout>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#game-engine-gallery",
    children: "a[data-pswp-width]",
    pswpModule: () => import("photoswipe"),
  });

  lightbox.init();
</script>

