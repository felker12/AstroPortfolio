---
import Layout from '@layouts/Layout.astro';
import {visibleScreenshots, features, hero, futureImprovements, flow} from '@data/projects/time-punch.ts';
import ProjectHero from '@components/ProjectComponents/ProjectHero.astro';
import ProjectShowcase from '@components/ProjectComponents/ProjectShowcase.astro';
import ProjectSplitSection from '@components/ProjectComponents/ProjectSplitSection.astro';
import ProjectFlow from '@components/ProjectComponents/ProjectFlow.astro';
import ProjectGallery from '@components/ProjectComponents/ProjectGallery.astro';
import ProjectFeatureGrid from '@components/ProjectComponents/ProjectFeatureGrid.astro';
---

<Layout
    title='Time Punch Management System | Kevin "Anthony" Felker'
    description="Case study for Time Punch Management System, a full-stack employee attendance application built with C#, ASP.NET Core, React, TypeScript, SQL Server, .NET Aspire, and Azure."
    canonical="https://anthonyfelker.com/projects/time-punch"
    keywords={[
        "Time Punch Management System",
        "employee time tracking application",
        "C# time tracking app",
        "ASP.NET Core project",
        "React TypeScript dashboard",
        "SQL Server",
        ".NET Aspire",
        "role based authentication",
        "attendance management"
    ]}
/>
    <div class="max-w-5xl mx-auto px-4 py-16 md:py-24">

        <div class="mb-8">
            <a href="/projects" class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 hover:text-cyan-400 transition-colors duration-200">
                <svg class="w-3 h-3 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
                Back to Projects
            </a>
        </div>

        <!-- Hero Section -->
        <ProjectHero {...hero} />

        <div id="timepunch-gallery">
            <!-- Showcase Screenshot -->
            <ProjectShowcase screenshot={visibleScreenshots[0]} />

            <!-- Project Overview Section -->
            <ProjectSplitSection
                title="Project Overview"
                subtitle="Context & Purpose"
                borderTop={false}
            >
                <div class="text-slate-300 text-sm leading-relaxed space-y-4">
                    <p>
                        This project was built around a practical business workflow: employee time tracking. 
                        The goal was to create an application where employees could record attendance and 
                        administrators could review time data in a structured interface.
                    </p>

                    <p>
                        Building it gave me more experience connecting a React and TypeScript frontend 
                        to an ASP.NET Core backend, designing API endpoints, working with SQL Server data, and organizing services with .NET Aspire.
                    </p>
                </div>
            </ProjectSplitSection>

            <!-- Application Workflow Section -->
            <ProjectFlow {...flow} />

            <!-- Key Features Section -->
            <ProjectFeatureGrid title="Key Features" subtitle="Application Functionality" features={features} />

            <!-- Gallery Section -->
            <ProjectGallery screenshots={visibleScreenshots} />
        </div>

        <!-- Technical Highlights -->
        <ProjectSplitSection
            title="Technical Highlights"
            subtitle="Stack Implementation"
            borderTop={false}
        >
            <div class="border-b border-slate-900 pb-4">
                <h3 class="text-sm font-mono text-cyan-400 font-semibold mb-1">ASP.NET Core APIs</h3>
                <p class="text-slate-300 text-xs leading-relaxed">
                    Built API endpoints for employee attendance actions, authentication workflows, and administrative data access.
                </p>
            </div>

            <div class="border-b border-slate-900 pb-4">
                <h3 class="text-sm font-mono text-cyan-400 font-semibold mb-1">SQL Server Data Model</h3>
                <p class="text-slate-300 text-xs leading-relaxed">
                    Designed relational tables for users, shifts, and time entries so attendance data could be stored and queried consistently.
                </p>
            </div>

            <div>
                <h3 class="text-sm font-mono text-cyan-400 font-semibold mb-1">React + TypeScript Frontend</h3>
                <p class="text-slate-300 text-xs leading-relaxed">
                    Developed dashboard views with reusable React components and TypeScript types to improve reliability across frontend data handling.
                </p>
            </div>
        </ProjectSplitSection>

        <!-- Challenges & Lessons Learned -->
        <ProjectSplitSection
            title="Challenges & Lessons Learned"
            subtitle="Problem Solving"
        >
            <ul class="space-y-3.5 text-xs text-slate-400 list-none pl-0">
                <li class="flex items-start gap-2.5 leading-relaxed">
                    <span class="text-cyan-500 text-md leading-none mt-0.5">▪</span>
                    <span><strong>State Management:</strong> Learned how important it is to keep frontend state aligned with backend attendance records.</span>
                </li>
                <li class="flex items-start gap-2.5 leading-relaxed">
                    <span class="text-cyan-500 text-md leading-none mt-0.5">▪</span>
                    <span><strong>Authentication Flow:</strong> Gained more experience handling login state, protected routes, and role-based access in a full-stack application.</span>
                </li>
                <li class="flex items-start gap-2.5 leading-relaxed">
                    <span class="text-cyan-500 text-md leading-none mt-0.5">▪</span>
                    <span><strong>Local Orchestration:</strong> Used .NET Aspire to organize the frontend and backend services during local development.</span>
                </li>
            </ul>
        </ProjectSplitSection>

        <!-- Future Improvements -->
        <ProjectSplitSection
            title="Future Improvements"
            subtitle="Planned Enhancements"
        >
             <div class="bg-black/20 border border-slate-900 rounded-xl p-6 hover:scale-105 transition-transform duration-300">
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {futureImprovements.map((item, index) => (
                        <li class="flex items-center gap-2 text-xs text-slate-400">
                            <span class="text-cyan-500 font-mono">
                                {String(index + 1).padStart(2, '0')}// {/* if end up with more than 10 impovements change to String(index + 1).padStart(3, '0') */}
                            </span>
                            {item}
                        </li>
                    ))}
                </ul>
            </div>
        </ProjectSplitSection> 

        <!-- Back to Projects -->
        <section class="text-center border-t border-slate-800/60 pt-12">
            <a 
                href="/projects" 
                class="inline-block border border-cyan-500/30 text-cyan-400 hover:bg-cyan-500/10 text-xs font-mono tracking-wider px-5 py-3 rounded-lg transition-colors duration-200"
            >
                Back to Projects
            </a>
        </section>
    </div>
</Layout>

<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import 'photoswipe/style.css';

    const lightbox = new PhotoSwipeLightbox({
        gallery: '#timepunch-gallery',
        children: 'a',
        pswpModule: () => import('photoswipe')
    });
    
    lightbox.init();
</script>