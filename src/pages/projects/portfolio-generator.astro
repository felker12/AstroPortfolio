---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import {
  hero,
  features,
  flow,
  technicalHighlights,
  challenges,
  futureImprovements,
  visibleScreenshots,
} from "@data/projects/portfolioGenerator.ts";
import ProjectHero from "@components/ProjectComponents/ProjectHero.astro";
import ProjectShowcase from "@components/ProjectComponents/ProjectShowcase.astro";
import ProjectSplitSection from "@components/ProjectComponents/ProjectSplitSection.astro";
import ProjectFlow from "@components/ProjectComponents/ProjectFlow.astro";
import ProjectGallery from "@components/ProjectComponents/ProjectGallery.astro";
import ProjectFeatureGrid from "@components/ProjectComponents/ProjectFeatureGrid.astro";
---

<Layout
  title='Portfolio Generator | Kevin "Anthony" Felker'
  description="Case study for Portfolio Generator, a full-stack C#, ASP.NET Core, React, TypeScript, .NET Aspire, Azure, and GitHub Actions application that converts Word resumes into portfolio websites."
  canonical="https://anthonyfelker.com/projects/portfolio-generator"
  keywords={[
    "Portfolio Generator",
    "C# portfolio generator",
    "ASP.NET Core project",
    "React TypeScript project",
    ".NET Aspire",
    "Azure App Service",
    "GitHub Actions",
    "resume parser",
    "DocumentFormat OpenXml",
  ]}
>
  <div class="mx-auto w-full max-w-375 px-4 sm:px-6 lg:px-8">
    <div class="relative z-3 pt-28">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 font-mono text-xs
          tracking-wide text-ink-dim no-underline
          transition-colors duration-200 hover:text-ice-300

          focus-visible:rounded-sm focus-visible:outline-none
          focus-visible:ring-2 focus-visible:ring-ice-400
          focus-visible:ring-offset-4 focus-visible:ring-offset-bg-deep"
      >
        <Icon name="mdi:arrow-left" class="h-4 w-4" />
        Back to projects
      </a>
    </div>

    <ProjectHero {...hero} />

    <div id="portfolio-gallery">
      <ProjectShowcase screenshot={visibleScreenshots[0]} />

      <ProjectSplitSection
        title="Project overview"
        subtitle="Context & purpose"
        borderTop={false}
      >
        <div class="space-y-5 leading-relaxed text-ink-dim">
          <p>
            Portfolio Generator was created to automate the process of turning
            a structured Microsoft Word resume into a responsive, multi-page
            portfolio website.
          </p>

          <p>
            The project combines document parsing, REST API development,
            frontend file handling, live theme previews, generated site output,
            and automated cloud deployment in one end-to-end workflow.
          </p>

          <p>
            Building it gave me practical experience designing a system that
            crosses multiple application boundaries while keeping each stage
            understandable, testable, and maintainable.
          </p>
        </div>
      </ProjectSplitSection>

      <ProjectFlow {...flow} />

      <ProjectFeatureGrid
        title="Key features"
        subtitle="Application functionality"
        features={features}
      />

      <ProjectGallery screenshots={visibleScreenshots} />
    </div>

    <ProjectFeatureGrid
      title="Technical highlights"
      subtitle="Architecture & implementation"
      features={technicalHighlights}
    />

    <ProjectSplitSection
      title="Challenges & solutions"
      subtitle="Problem solving"
    >
      <ul class="space-y-4 text-sm leading-relaxed text-ink-dim">
        {
          challenges.map((item) => (
            <li
              class="relative pl-5
                before:absolute before:left-0 before:top-[0.68em]
                before:h-1 before:w-1 before:rounded-full
                before:bg-ice-400
                before:shadow-[0_0_7px_rgba(67,199,255,0.7)]
                before:content-['']"
            >
              <strong class="font-semibold text-ink-soft">
                {item.title}
              </strong>{" "}
              {item.description}
            </li>
          ))
        }
      </ul>
    </ProjectSplitSection>

    <ProjectSplitSection
      title="Future improvements"
      subtitle="Planned enhancements"
    >
      <ol class="grid list-none gap-3 p-0 sm:grid-cols-2">
        {
          futureImprovements.map((item, index) => (
            <li
              class="flex items-start gap-3 rounded-xl border
                border-ice-100/10 bg-[rgba(3,20,34,0.56)] p-4"
            >
              <span
                class="shrink-0 font-mono text-xs tracking-wide text-ice-400"
              >
                {String(index + 1).padStart(2, "0")}
              </span>

              <span class="text-sm leading-relaxed text-ink-dim">
                {item}
              </span>
            </li>
          ))
        }
      </ol>
    </ProjectSplitSection>

    <section
      class="reveal-target relative flex min-h-[58svh]
        items-center justify-center py-24 text-center

        before:absolute before:inset-x-0 before:top-0 before:h-px
        before:bg-linear-to-r before:from-transparent
        before:via-ice-100/10 before:to-transparent before:content-['']"
    >
      <div class="reveal relative z-3 w-full max-w-170">
        <p
          class="mb-3 font-mono text-xs tracking-[0.13em]
            text-ice-400 before:text-ice-800 before:content-['//_']"
        >
          Continue exploring
        </p>

        <h2
          class="mb-5 font-display text-[clamp(2rem,5vw,3.5rem)]
            font-bold leading-[1.08] tracking-[-0.04em] text-ink"
        >
          Explore more
          <span class="ml-[0.22em] text-ice-400">engineering projects.</span>
        </h2>

        <p
          class="mx-auto mb-7 max-w-[54ch]
            text-[clamp(0.98rem,1.5vw,1.08rem)] text-ink-dim"
        >
          Browse additional full-stack applications, production websites, and
          software projects covering APIs, databases, testing, and deployment.
        </p>

        <a
          href="/projects"
          class="inline-flex min-h-12 items-center justify-center gap-2.5
            rounded-xl border border-ice-300/50
            bg-linear-to-br from-[rgba(21,133,190,0.82)]
            to-[rgba(23,92,135,0.72)] px-5
            font-mono text-sm font-semibold tracking-wide
            text-ice-50 no-underline
            shadow-[0_0_32px_rgba(42,178,255,0.2)]
            transition-all duration-150
            hover:-translate-y-0.5 hover:border-ice-200
            hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
        >
          Back to projects
          <Icon name="mdi:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: "#portfolio-gallery",
    children: "a[data-pswp-width]",
    pswpModule: () => import("photoswipe"),
  });

  lightbox.init();
</script>
