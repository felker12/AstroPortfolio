---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import ProjectShowcase from "@components/ProjectShowcase.astro";
import { projects } from "@data/pages/Projects";
---

<Layout
  title='Projects | Kevin "Anthony" Felker'
  description="Explore software development projects by Kevin Anthony Felker, including full-stack .NET applications, React and TypeScript frontends, Astro websites, CI/CD workflows, Azure deployments, and a custom C# MonoGame RPG engine."
  canonical="https://anthonyfelker.com/projects"
  keywords={[
    "Kevin Anthony Felker projects",
    "Anthony Felker portfolio projects",
    "Full Stack Developer projects",
    "C# projects",
    ".NET projects",
    "ASP.NET Core projects",
    "React TypeScript projects",
    "Azure deployment projects",
    "GitHub Actions CI/CD",
    "MonoGame RPG engine",
  ]}
>
  <!-- Page introduction -->
  <section
    class="relative mx-auto flex min-h-[72svh] max-w-375 items-center
      px-4 py-28 sm:px-[clamp(1.25rem,6vw,7rem)]

      before:absolute before:bottom-[12%] before:left-3 before:top-[12%]
      before:w-px before:bg-linear-to-b before:from-transparent
      before:via-ice-100/20 before:to-transparent before:content-['']
      sm:before:left-[clamp(0.75rem,3vw,2rem)]"
  >
    <div class="relative z-3 w-full max-w-220">
      <p
        class="mb-4 font-mono text-sm tracking-[0.12em] text-ice-400
          before:mr-1 before:text-ice-800 before:content-['<']
          after:ml-1 after:text-ice-800 after:content-['/>']"
      >
        Selected projects
      </p>

      <h1
        class="m-0 max-w-[15ch] text-balance font-display
          text-[clamp(2.8rem,7vw,6rem)] font-extrabold leading-[0.98]
          tracking-[-0.055em] text-ink"
      >
        Software built around
        <span
          class="ml-[0.22em] text-ice-400
            drop-shadow-[0_0_28px_rgba(67,199,255,0.28)]"
        >
          real problems.
        </span>
      </h1>

      <p
        class="mt-6 max-w-[62ch]
          text-[clamp(1rem,1.8vw,1.18rem)]
          leading-relaxed text-ink-dim"
      >
        A selection of full-stack applications, development tools, production
        websites, and engineering projects that demonstrate how I approach
        architecture, implementation, testing, deployment, and long-term
        maintainability.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#project-list"
          class="inline-flex min-h-12 items-center justify-center gap-2.5
            rounded-xl border border-ice-300/50
            bg-linear-to-br from-[rgba(21,133,190,0.82)]
            to-[rgba(23,92,135,0.72)] px-5
            font-mono text-sm font-semibold tracking-wide
            text-ice-50 no-underline
            shadow-[0_0_32px_rgba(42,178,255,0.2)]
            transition-all duration-150
            hover:-translate-y-0.5 hover:border-ice-200
            hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
        >
          Explore projects
          <span aria-hidden="true">↓</span>
        </a>

        <a
          href="https://github.com/felker12"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-12 items-center justify-center gap-2.5
            rounded-xl border border-ice-100/20
            bg-[rgba(4,25,42,0.52)] px-5
            font-mono text-sm font-semibold tracking-wide
            text-ice-200 no-underline backdrop-blur-md
            transition-all duration-150
            hover:-translate-y-0.5 hover:border-ice-300/50
            hover:bg-[rgba(8,48,75,0.66)] hover:text-ice-50"
        >
          <Icon name="mdi:github" class="h-5 w-5" />
          GitHub profile
        </a>
      </div>
    </div>
  </section>

  <!-- Project list -->
  <section
    id="project-list"
    class="relative mx-auto max-w-375 scroll-mt-24
      px-4 py-24 sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div class="mb-12 max-w-190">
      <p
        class="mb-3 font-mono text-xs tracking-[0.12em]
          text-ice-400 before:text-ice-800 before:content-['//_']"
      >
        Project archive
      </p>

      <h2
        class="font-display text-[clamp(2rem,5vw,3.5rem)]
          font-bold leading-[1.08] tracking-[-0.04em] text-ink"
      >
        From working prototypes to
        <span class="ml-[0.22em] text-ice-400">deployed systems.</span>
      </h2>

      <p class="mt-5 max-w-[62ch] leading-relaxed text-ink-dim">
        Each project reflects a different part of my experience, including API
        development, frontend architecture, relational databases, testing,
        deployment automation, production support, and reusable system design.
      </p>
    </div>

    <div class="space-y-30">
        {
            projects.map((project, index) => (
            <ProjectShowcase
                project={project}
                index={index}
            />
            ))
        }
    </div>
  </section>

  <!-- Closing CTA -->
  <section
    class="reveal-target relative flex min-h-[80svh] items-center
      justify-center px-4 py-28 text-center
      sm:px-[clamp(1.25rem,6vw,7rem)]"
  >
    <div class="reveal relative z-3 w-full max-w-170">
      <p
        class="mb-3 font-mono text-xs tracking-[0.13em]
          text-ice-400 before:text-ice-800 before:content-['//_']"
      >
        Have a project or opportunity?
      </p>

      <h2
        class="mb-5 font-display text-[clamp(2rem,5vw,3.5rem)]
          font-bold leading-[1.08] tracking-[-0.04em] text-ink"
      >
        Let’s discuss what needs to become
        <span class="ml-[0.22em] text-ice-400">working software.</span>
      </h2>

      <p
        class="mx-auto mb-7 max-w-[54ch]
          text-[clamp(0.98rem,1.5vw,1.08rem)] text-ink-dim"
      >
        Reach out about a software engineering role, production website,
        full-stack application, or technical problem that needs a dependable
        path forward.
      </p>

      <a
        href="/contact"
        class="inline-flex min-h-12 items-center justify-center gap-2.5
          rounded-xl border border-ice-300/50
          bg-linear-to-br from-[rgba(21,133,190,0.82)]
          to-[rgba(23,92,135,0.72)] px-5
          font-mono text-sm font-semibold tracking-wide
          text-ice-50 no-underline
          shadow-[0_0_32px_rgba(42,178,255,0.2)]
          transition-all duration-150
          hover:-translate-y-0.5 hover:border-ice-200
          hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
      >
        Start a conversationy
      </a>
    </div>
  </section>
</Layout>
