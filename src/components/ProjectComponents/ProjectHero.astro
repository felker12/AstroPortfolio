---
import type { ProjectHeroData } from '@data/projects/projects';

const {
    category,
    title,
    description,
    tags,
    githubUrl,
    demoUrl
} = Astro.props as ProjectHeroData;
---

<section class="mb-16">

    <!-- Category -->
    <p class="text-cyan-400 font-mono text-xs uppercase tracking-widest">
        {category}
    </p>

    <!-- Title -->
    <h1 class="text-4xl md:text-5xl font-light text-white mt-2 mb-4 tracking-tight">
        {title}
    </h1>

    <!-- Description -->
    <p class="text-md md:text-lg text-slate-300 max-w-3xl leading-relaxed mb-6">
        {description}
    </p>

    <!-- Technology Tags -->
    <div class="flex flex-wrap gap-1.5 mb-8">
        {tags.map((tag) => (
            <span
                class="bg-slate-950/60 border border-slate-800/80
                       text-slate-300 font-mono text-[11px]
                       px-2.5 py-0.5 rounded"
            >
                {tag}
            </span>
        ))}
    </div>

    <!-- Buttons -->
    <div class="flex flex-wrap gap-4">

        {githubUrl && (
            <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2
                       border border-slate-700
                       hover:border-slate-500
                       hover:bg-slate-900/50
                       text-slate-200
                       text-xs
                       font-medium
                       px-5 py-2.5
                       rounded-lg
                       transition-all duration-200"
            >
                <svg
                    class="w-4 h-4 fill-current"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"
                    />
                </svg>

                Code Repository
            </a>
        )}

        {demoUrl && (
            <a
                href={demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5
                       bg-cyan-600
                       hover:bg-cyan-500
                       text-white
                       text-xs
                       font-medium
                       px-5 py-2.5
                       rounded-lg
                       transition-all duration-200
                       shadow-md shadow-cyan-950/20"
            >
                Launch Live Demo

                <svg
                    class="w-3 h-3 stroke-current"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                    />
                </svg>
            </a>
        )}

    </div>

</section>