---
import { Icon } from "astro-icon/components";
import type { ProjectHeroData } from "@data/projects/projects";

const {
  category,
  title,
  description,
  tags,
  githubUrl,
  demoUrl,
} = Astro.props as ProjectHeroData;
---

<section
  class="relative flex min-h-[72svh] items-center py-20
    before:absolute before:bottom-[12%] before:left-0 before:top-[12%]
    before:w-px before:bg-linear-to-b before:from-transparent
    before:via-ice-100/20 before:to-transparent before:content-['']"
>
  <div class="relative z-3 w-full max-w-235 pl-5 sm:pl-8">
    <p
      class="mb-4 font-mono text-sm tracking-[0.12em] text-ice-400
        before:mr-1 before:text-ice-800 before:content-['<']
        after:ml-1 after:text-ice-800 after:content-['/>']"
    >
      {category}
    </p>

    <h1
      class="m-0 max-w-[16ch] text-balance font-display
        text-[clamp(2.8rem,7vw,6rem)] font-extrabold leading-[0.98]
        tracking-[-0.055em] text-ink"
    >
      {title}
    </h1>

    <p
      class="mt-6 max-w-[64ch]
        text-[clamp(1rem,1.8vw,1.18rem)]
        leading-relaxed text-ink-dim"
    >
      {description}
    </p>

    <ul
      class="mt-7 flex list-none flex-wrap gap-2 p-0"
      aria-label={`${title} technologies`}
    >
      {
        tags.map((tag) => (
          <li
            class="tech-tag rounded-md border border-ice-100/10
              bg-[rgba(5,29,47,0.58)] px-2.5 py-1.5
              font-mono text-xs tracking-wide text-ice-200
              transition-all duration-150

              [&.is-active]:-translate-y-0.5
              [&.is-active]:border-ice-300/50
              [&.is-active]:bg-[rgba(9,60,92,0.68)]
              [&.is-active]:text-ice-50
              [&.is-active]:shadow-[0_0_18px_rgba(67,199,255,0.12)]"
          >
            {tag}
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex flex-wrap gap-3">
      {
        demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center gap-2.5
              rounded-xl border border-ice-300/50
              bg-linear-to-br from-[rgba(21,133,190,0.82)]
              to-[rgba(23,92,135,0.72)] px-5
              font-mono text-sm font-semibold tracking-wide
              text-ice-50 no-underline
              shadow-[0_0_32px_rgba(42,178,255,0.2)]
              transition-all duration-150
              hover:-translate-y-0.5 hover:border-ice-200
              hover:shadow-[0_0_42px_rgba(86,211,255,0.3)]"
          >
            Launch live demo
            <Icon name="mdi:open-in-new" class="h-4 w-4" />
          </a>
        )
      }

      {
        githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center gap-2.5
              rounded-xl border border-ice-100/20
              bg-[rgba(4,25,42,0.52)] px-5
              font-mono text-sm font-semibold tracking-wide
              text-ice-200 no-underline backdrop-blur-md
              transition-all duration-150
              hover:-translate-y-0.5 hover:border-ice-300/50
              hover:bg-[rgba(8,48,75,0.66)] hover:text-ice-50"
          >
            <Icon name="mdi:github" class="h-5 w-5" />
            Code repository
          </a>
        )
      }
    </div>
  </div>
</section>
