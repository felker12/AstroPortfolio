---
import type { Feature } from "@data/projects/projects";
import ProjectSectionHeader from "./ProjectSectionHeader.astro";

interface Props {
  title: string;
  subtitle: string;
  features: Feature[];
}

const { title, subtitle, features } = Astro.props as Props;
---

<section
  class="reveal-target relative py-20
    before:absolute before:inset-x-0 before:top-0 before:h-px
    before:bg-linear-to-r before:from-transparent
    before:via-ice-100/10 before:to-transparent before:content-['']"
>
  <div class="reveal">
    <div class="mb-10">
      <ProjectSectionHeader title={title} subtitle={subtitle} />
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature, index) => (
          <article
            class="panel-tilt pointer-glow relative overflow-hidden
              rounded-2xl border border-ice-100/10 p-6
              bg-[linear-gradient(145deg,rgba(23,98,139,0.13),rgba(3,18,31,0.6))]
              shadow-[inset_0_1px_0_rgba(222,247,255,0.04),0_18px_45px_rgba(0,7,14,0.24)]
              backdrop-blur-xl transition-all duration-200

              hover:border-ice-300/30
              hover:shadow-[inset_0_1px_0_rgba(222,247,255,0.06),0_22px_52px_rgba(0,7,14,0.34)]

              before:absolute before:left-6 before:top-0 before:h-px
              before:w-14 before:bg-ice-400
              before:shadow-[0_0_12px_rgba(67,199,255,0.7)]
              before:content-['']"
          >
            <div class="mb-4 flex items-start justify-between gap-4">
              <h3 class="font-display text-lg font-semibold text-ink">
                {feature.title}
              </h3>

              <span
                class="font-mono text-xs tracking-wider text-ice-700"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>

            <p class="text-sm leading-relaxed text-ink-dim">
              {feature.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
