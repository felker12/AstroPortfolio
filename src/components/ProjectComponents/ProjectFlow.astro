---
import type { FlowStep } from "@data/projects/projects";
import ProjectSectionHeader from "./ProjectSectionHeader.astro";
import ProjectFlowNode from "./ProjectFlowNode.astro";
import ProjectFlowConnector from "./ProjectFlowConnector.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  workflow: FlowStep[];
}

const { title, subtitle, description, workflow } =
  Astro.props as Props;

const FLOW_ANIMATION_MS = 3600;
const FLOW_STAGGER_MS = 700;
---

<section
  class="reveal-target relative py-20

    before:absolute before:inset-x-0 before:top-0
    before:h-px before:bg-linear-to-r
    before:from-transparent before:via-ice-100/10
    before:to-transparent before:content-['']"
>
  <div class="reveal">
    <div class="mb-10">
      <ProjectSectionHeader
        title={title}
        subtitle={subtitle}
      />
    </div>

    <div
      class="pointer-glow relative overflow-hidden rounded-2xl
        border border-ice-100/10 p-6
        bg-[linear-gradient(135deg,rgba(18,76,111,0.12),transparent_48%),rgba(3,19,32,0.68)]
        shadow-[inset_0_1px_0_rgba(222,247,255,0.06),0_24px_70px_rgba(0,7,14,0.38)]
        backdrop-blur-xl md:p-8

        before:absolute before:-top-px before:left-8
        before:h-px before:w-24 before:bg-linear-to-r
        before:from-transparent before:via-ice-400
        before:to-transparent
        before:shadow-[0_0_14px_rgba(67,199,255,0.72)]
        before:content-['']"
    >
      <p
        class="mx-auto mb-12 max-w-[66ch] text-center
          text-sm leading-relaxed text-ink-dim"
      >
        {description}
      </p>

      <!-- Desktop workflow -->
      <ol
        class="hidden list-none items-start p-0 lg:flex"
        aria-label={`${title} workflow`}
      >
        {
          workflow.map((step, index) => (
            <>
              <ProjectFlowNode
                step={step}
                descriptionWidthClass="max-w-38"
              />

              {index < workflow.length - 1 && (
                <ProjectFlowConnector
                  orientation="horizontal"
                  durationMs={FLOW_ANIMATION_MS}
                  delayMs={index * FLOW_STAGGER_MS}
                />
              )}
            </>
          ))
        }
      </ol>

      <!-- Mobile workflow -->
      <ol
        class="flex list-none flex-col items-center p-0 lg:hidden"
        aria-label={`${title} workflow`}
      >
        {
          workflow.map((step, index) => (
            <>
              <ProjectFlowNode
                step={step}
                descriptionWidthClass="max-w-48"
              />

              {index < workflow.length - 1 && (
                <ProjectFlowConnector
                  orientation="vertical"
                  durationMs={FLOW_ANIMATION_MS}
                  delayMs={index * FLOW_STAGGER_MS}
                />
              )}
            </>
          ))
        }
      </ol>
    </div>
  </div>
</section>
