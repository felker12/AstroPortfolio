---
import { type NavLink } from "@data/navbar/nav.ts";
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  label: string;
  ariaLabel: string;
  children?: NavLink[];
  isActive: boolean;
}

const {
  href,
  label,
  ariaLabel,
  isActive,
  children,
} = Astro.props;

const hasChildren = (children?.length ?? 0) > 0;
---

<a
  href={href}
  aria-label={ariaLabel}
  aria-current={isActive ? "page" : undefined}
  class:list={[
    `relative inline-flex items-center gap-1
    rounded-sm font-mono text-xs tracking-wide
    no-underline transition-colors duration-150

    after:absolute after:inset-x-0 after:-bottom-1.5 after:h-px
    after:bg-ice-400
    after:shadow-[0_0_8px_rgba(67,199,255,0.75)]
    after:transition-transform after:duration-150

    focus-visible:outline-none
    focus-visible:ring-2
    focus-visible:ring-ice-400
    focus-visible:ring-offset-4
    focus-visible:ring-offset-slate-950`,

    isActive
      ? `text-ice-100
        after:origin-left after:scale-x-100`
      : `text-ink-dim
        after:origin-right after:scale-x-0
        hover:text-ice-50
        hover:after:origin-left
        hover:after:scale-x-100`,
  ]}
>
  {label}

  {hasChildren && (
    <Icon name="mdi:chevron-down" size={16} color="currentColor" class="transition-transform duration-200 hidden md:block
        group-hover:rotate-180 group-focus-within:rotate-180"/>
  )}
</a>