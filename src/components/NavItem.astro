---
import { type NavLink } from "@data/navbar/nav.ts";

interface Props {
  href: string;
  label: string;
  ariaLabel: string;
  children?: NavLink[];
  isActive: boolean;
}

const {
  href,
  label,
  ariaLabel,
  isActive,
  children,
} = Astro.props;

const hasChildren = (children?.length ?? 0) > 0;
---

<a
  href={href}
  aria-label={ariaLabel}
  aria-current={isActive ? "page" : undefined}
  class:list={[
    `relative inline-flex items-center gap-1 rounded
    font-mono text-sm tracking-wide no-underline
    transition-colors duration-200

    after:absolute after:inset-x-0 after:-bottom-1.5 after:h-px
    after:bg-cyan-400
    after:shadow-[0_0_8px_rgba(34,211,238,0.75)]
    after:transition-transform after:duration-200

    focus-visible:outline-none
    focus-visible:ring-2
    focus-visible:ring-cyan-400
    focus-visible:ring-offset-2
    focus-visible:ring-offset-slate-900`,

    isActive
      ? `font-semibold text-cyan-400
        after:origin-left after:scale-x-100`
      : `text-slate-300
        after:origin-right after:scale-x-0
        hover:text-white
        hover:after:origin-left
        hover:after:scale-x-100`,
  ]}
>
  {label}

  {hasChildren && (
    <svg
      class="h-3 w-3 stroke-current transition-transform duration-200
        group-hover:rotate-180
        group-focus-within:rotate-180"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m19.5 8.25-7.5 7.5-7.5-7.5"
      />
    </svg>
  )}
</a>