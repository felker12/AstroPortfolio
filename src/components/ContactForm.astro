---
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="contact-form"
  class="needs-validation space-y-5"
  novalidate
>
  <input type="hidden" name="access_key" value={web3formsKey} />

  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
  />

  <!-- Full name -->
  <div class="space-y-2">
    <label
      for="name"
      class="block font-mono text-[0.66rem] tracking-[0.12em] text-ice-300"
    >
      Full name
    </label>

    <input
      id="name"
      type="text"
      name="name"
      autocomplete="name"
      placeholder="John Doe"
      required
      class="w-full rounded-xl border border-ice-100/10
        bg-[rgba(2,14,25,0.72)] px-4 py-3.5
        text-sm text-ink placeholder:text-ink-dim/50
        shadow-[inset_0_1px_0_rgba(222,247,255,0.03)]
        outline-none backdrop-blur-md
        transition-[border-color,box-shadow,background-color] duration-200

        hover:border-ice-100/20
        focus:border-ice-300/50
        focus:bg-[rgba(4,24,40,0.8)]
        focus:ring-4 focus:ring-ice-400/10"
    />

    <p
      class="empty-feedback invalid-feedback hidden pl-1
        font-mono text-xs text-red-300"
    >
      Please provide your full name.
    </p>
  </div>

  <!-- Email -->
  <div class="space-y-2">
    <label
      for="email_address"
      class="block font-mono text-[0.66rem] tracking-[0.12em] text-ice-300"
    >
      Email address
    </label>

    <input
      id="email_address"
      type="email"
      name="email"
      autocomplete="email"
      placeholder="you@example.com"
      required
      class="w-full rounded-xl border border-ice-100/10
        bg-[rgba(2,14,25,0.72)] px-4 py-3.5
        text-sm text-ink placeholder:text-ink-dim/50
        shadow-[inset_0_1px_0_rgba(222,247,255,0.03)]
        outline-none backdrop-blur-md
        transition-[border-color,box-shadow,background-color] duration-200

        hover:border-ice-100/20
        focus:border-ice-300/50
        focus:bg-[rgba(4,24,40,0.8)]
        focus:ring-4 focus:ring-ice-400/10"
    />

    <p
      class="empty-feedback hidden pl-1
        font-mono text-xs text-red-300"
    >
      Please provide your email address.
    </p>

    <p
      class="invalid-feedback hidden pl-1
        font-mono text-xs text-red-300"
    >
      Please provide a valid email address.
    </p>
  </div>

  <!-- Message -->
  <div class="space-y-2">
    <label
      for="message"
      class="block font-mono text-[0.66rem] tracking-[0.12em] text-ice-300"
    >
      Message
    </label>

    <textarea
      id="message"
      name="message"
      required
      rows="6"
      placeholder="Tell me a little about the opportunity or project."
      class="min-h-40 w-full resize-y rounded-xl
        border border-ice-100/10
        bg-[rgba(2,14,25,0.72)] px-4 py-3.5
        text-sm leading-relaxed text-ink
        placeholder:text-ink-dim/50
        shadow-[inset_0_1px_0_rgba(222,247,255,0.03)]
        outline-none backdrop-blur-md
        transition-[border-color,box-shadow,background-color] duration-200

        hover:border-ice-100/20
        focus:border-ice-300/50
        focus:bg-[rgba(4,24,40,0.8)]
        focus:ring-4 focus:ring-ice-400/10"
    ></textarea>

    <p
      class="empty-feedback invalid-feedback hidden pl-1
        font-mono text-xs text-red-300"
    >
      Please enter your message.
    </p>
  </div>

  <!-- Submit -->
  <button
    type="submit"
    class="group relative inline-flex min-h-12 w-full
      items-center justify-center gap-2.5 overflow-hidden
      rounded-xl border border-ice-300/50
      bg-linear-to-br from-[rgba(21,133,190,0.82)]
      to-[rgba(23,92,135,0.72)] px-5
      font-mono text-sm font-semibold tracking-wide
      text-ice-50
      shadow-[0_0_32px_rgba(42,178,255,0.18)]
      transition-all duration-200

      before:absolute before:inset-0
      before:bg-linear-to-r before:from-transparent
      before:via-white/8 before:to-transparent
      before:-translate-x-full
      before:transition-transform before:duration-500
      before:content-['']

      hover:-translate-y-0.5
      hover:border-ice-200
      hover:shadow-[0_0_42px_rgba(86,211,255,0.26)]
      hover:before:translate-x-full

      focus-visible:outline-none
      focus-visible:ring-2
      focus-visible:ring-ice-300
      focus-visible:ring-offset-2
      focus-visible:ring-offset-bg-deep

      disabled:cursor-not-allowed
      disabled:opacity-60
      disabled:hover:translate-y-0"
  >
    <span class="relative z-1">Send message</span>
  </button>

  <p
    id="form-result"
    class="min-h-6 text-center font-mono text-sm"
    role="status"
    aria-live="polite"
  ></p>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .was-validated :invalid {
    border-color: rgba(252, 165, 165, 0.75);
    box-shadow:
      0 0 0 4px rgba(239, 68, 68, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
</style>

<script is:inline>
  const form = document.getElementById("contact-form");
  const result = document.getElementById("form-result");

  if (form instanceof HTMLFormElement && result) {
    const submitButton = form.querySelector('button[type="submit"]');

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      form.classList.add("was-validated");

      if (!form.checkValidity()) {
        form.querySelector(":invalid")?.focus();
        return;
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      result.className =
        "min-h-6 text-center font-mono text-sm text-ink-dim";
      result.textContent = "Sending...";

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        if (!payload.botcheck) {
          payload.botcheck = "";
        }

        const response = await fetch(
          "https://api.web3forms.com/submit",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          }
        );

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data.message || "Unable to send your message."
          );
        }

        result.className =
          "min-h-6 text-center font-mono text-sm text-emerald-300";
        result.textContent =
          data.message || "Message sent successfully.";

        form.reset();
        form.classList.remove("was-validated");
      } catch (error) {
        console.error(error);

        result.className =
          "min-h-6 text-center font-mono text-sm text-red-300";
        result.textContent =
          error instanceof Error
            ? error.message
            : "Something went wrong. Please try again.";
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }

        window.setTimeout(() => {
          result.textContent = "";
        }, 5000);
      }
    });
  }
</script>