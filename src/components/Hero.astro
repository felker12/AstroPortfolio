---
import { heroContent } from "@data/components/Hero";
---

<section 
  class="hero relative mx-auto flex min-h-svh max-w-7xl 
  items-center px-4 py-28 sm:px-[clamp(1.25rem,6vw,7rem)]
  before:content-[''] before:absolute before:left-3 before:top-[15%] 
  before:bottom-[15%] before:w-px before:bg-linear-to-b before:from-transparent 
  before:via-ice-100/20 before:to-transparent sm:before:left-[clamp(0.75rem,3vw,2rem)]
  after:content-[''] after:absolute after:bottom-[12%] after:left-4 after:h-px after:w-[min(42rem,74vw)] 
  after:opacity-50 after:bg-linear-to-r after:from-ice-400 
  after:via-ice-100/10 after:to-transparent sm:after:left-[clamp(1.25rem,6vw,7rem)]"
>
  <div class="relative z-2 w-full max-w-200">
    <p
      class="mb-4 font-mono text-sm tracking-[0.12em] text-ice-400
        before:content-['<'] before:text-ice-800
        after:content-['/>'] after:text-ice-800"
    >
      {heroContent.eyebrow}
    </p>

    <h1
      class="m-0 max-w-[15ch] text-balance font-display text-[clamp(2rem,6vw,6rem)] font-extrabold leading-[0.98] tracking-[-0.055em] text-ink
        [&_em]:not-italic [&_em]:text-ice-400 [&_em]:drop-shadow-[0_0_28px_rgba(67,199,255,0.28)] max-sm:max-w-[10ch]"
      set:html={heroContent.titleHtml}
    />

    <p class="mt-6 max-w-[55ch] text-[clamp(1rem,1.8vw,1.18rem)] text-ink-dim">
      {heroContent.body}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3.5 max-[430px]:flex-col max-[430px]:items-stretch">
      <a
        href={heroContent.primaryCta.href}
        class="inline-flex min-h-12 items-center justify-center gap-2.5 rounded-xl border border-ice-300/50 bg-linear-to-br from-[rgba(21,133,190,0.82)] to-[rgba(23,92,135,0.72)] px-5 font-mono text-sm font-semibold tracking-wide text-ice-50 no-underline shadow-[0_0_32px_rgba(42,178,255,0.2)] transition-all duration-150 hover:-translate-y-0.5 hover:border-ice-200 hover:shadow-[0_0_42px_rgba(86,211,255,0.3)] max-[430px]:w-full"
      >
        {heroContent.primaryCta.label}
        <span aria-hidden="true">→</span>
      </a>

      <a
        href={heroContent.secondaryCta.href}
        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-ice-100/20 bg-[rgba(4,25,42,0.52)] px-5 font-mono text-sm font-semibold tracking-wide text-ice-200 no-underline backdrop-blur-md transition-all duration-150 hover:-translate-y-0.5 hover:border-ice-300/50 hover:bg-[rgba(8,48,75,0.66)] hover:text-ice-50 max-[430px]:w-full"
      >
        {heroContent.secondaryCta.label}
      </a>
    </div>

    <ul aria-label="Primary technologies" class="mt-7 flex flex-wrap gap-2 list-none p-0">
      {
        heroContent.tech.map((item) => (
          <li class="tech-tag rounded-md border border-ice-100/10 bg-[rgba(3,20,34,0.52)] px-2.5 py-1.5 font-mono text-xs tracking-wide text-ink-dim backdrop-blur-sm transition-all duration-150
            [&.is-active]:-translate-y-0.5 [&.is-active]:border-ice-300/50 [&.is-active]:bg-[rgba(9,60,92,0.68)] [&.is-active]:text-ice-50 [&.is-active]:shadow-[0_0_18px_rgba(67,199,255,0.12)]">
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="absolute bottom-8 left-4 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.14em] text-ink-dim sm:left-[clamp(1.25rem,6vw,7rem)] max-sm:bottom-6">
    <span class="relative h-px w-9 overflow-hidden bg-ice-100/30">
      <span class="absolute inset-y-0 -left-full w-full bg-ice-400 shadow-[0_0_8px_var(--color-ice-400)] animate-[scan-scroll_1.8s_ease-in-out_infinite]"></span>
    </span>
    Scroll to explore
  </div>
</section>
