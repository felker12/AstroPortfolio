---
import { type NavLink } from "@data/navbar/nav.ts";

interface Props {
  pathname: string;
  projectLinks: NavLink[];
}

const { pathname, projectLinks } = Astro.props;
---

<!-- Desktop dropdown -->
<ul
  class="pointer-events-none invisible absolute left-0 top-full hidden min-w-64
    translate-y-2 pt-3 opacity-0
    transition-all duration-200 ease-out
    group-hover:pointer-events-auto group-hover:visible group-hover:translate-y-0 group-hover:opacity-100
    group-focus-within:pointer-events-auto group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100
    md:block"
>
  <li
    class="relative overflow-hidden rounded-xl border border-cyan-100/10
      bg-[rgba(2,12,24,0.94)] shadow-[0_18px_50px_rgba(0,0,0,0.45)]
      backdrop-blur-xl

      before:absolute before:inset-x-0 before:top-0 before:h-px
      before:bg-linear-to-r before:from-transparent before:via-cyan-300/50 before:to-transparent"
  >
    <div class="border-b border-white/5 px-4 py-3">
      <p
        class="font-mono text-[0.62rem] uppercase tracking-[0.18em]
          text-slate-500"
      >
        Featured Projects
      </p>
    </div>

    <ul class="p-2">
      {
        projectLinks.map((project) => {
          const projectActive = pathname.startsWith(project.href);

          return (
            <li>
              <a
                href={project.href}
                aria-label={project.ariaLabel}
                aria-current={projectActive ? "page" : undefined}
                class:list={[
                  `group/project relative flex items-center justify-between gap-4
                  rounded-lg px-3 py-3 text-sm no-underline
                  transition-[background,color,transform,box-shadow] duration-200

                  before:absolute before:left-0 before:top-1/2 before:h-6
                  before:w-px before:-translate-y-1/2 before:bg-cyan-400
                  before:shadow-[0_0_10px_rgba(34,211,238,0.85)]
                  before:transition-opacity before:duration-200

                  focus-visible:outline-none
                  focus-visible:ring-2
                  focus-visible:ring-cyan-400/70`,

                  projectActive
                    ? `bg-cyan-400/10 text-cyan-300
                      shadow-[inset_0_0_18px_rgba(34,211,238,0.04)]
                      before:opacity-100`
                    : `text-slate-300 before:opacity-0
                      hover:translate-x-0.5
                      hover:bg-white/4.5
                      hover:text-white
                      hover:before:opacity-100`,
                ]}
              >
                <span>{project.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </li>
</ul>

<!-- Mobile project links -->
<ul
  class="ml-4 mt-2 space-y-1 border-l border-cyan-100/10 pl-4 md:hidden"
>
  {
    projectLinks.map((project) => {
      const projectActive = pathname.startsWith(project.href);

      return (
        <li>
          <a
            href={project.href}
            aria-label={project.ariaLabel}
            aria-current={projectActive ? "page" : undefined}
            class:list={[
              `relative block rounded-md px-3 py-2 font-mono text-xs
              tracking-wide no-underline transition-colors duration-200

              before:absolute before:left-[-1.05rem] before:top-1/2
              before:h-1.5 before:w-1.5 before:-translate-y-1/2
              before:rounded-full before:bg-cyan-400
              before:shadow-[0_0_8px_rgba(34,211,238,0.8)]
              before:transition-opacity before:duration-200

              focus-visible:outline-none
              focus-visible:ring-2
              focus-visible:ring-cyan-400
              focus-visible:ring-offset-2
              focus-visible:ring-offset-slate-950`,

              projectActive
                ? `bg-cyan-400/10 font-semibold text-cyan-300
                  before:opacity-100`
                : `text-slate-400 before:opacity-0
                  hover:bg-white/4
                  hover:text-white
                  hover:before:opacity-100`,
            ]}
          >
            {project.label}
          </a>
        </li>
      );
    })
  }
</ul>