---
interface Props {
  mode?: "hero" | "subtle";
}

const { mode = "hero" } = Astro.props;
---

<!-- Three.js canvas -->
<canvas
  id="aurora-canvas"
  data-mode={mode}
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-0 block h-full w-full"
></canvas>

<!-- Grid overlay -->
<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-1
    bg-[linear-gradient(rgba(82,190,240,0.07)_1px,transparent_1px),linear-gradient(90deg,rgba(82,190,240,0.07)_1px,transparent_1px)]
    bg-size-[64px_64px] opacity-[0.24]
    mask-[linear-gradient(to_bottom,rgba(0,0,0,0.68),transparent_82%)]
    max-sm:bg-size-[42px_42px]"
></div>

<!-- Grain / noise overlay -->
<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-2
    bg-grain opacity-[0.022] mix-blend-screen"
></div>

<!-- Vignette and vertical shading overlay -->
<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-2
    bg-[linear-gradient(180deg,rgba(1,7,14,0.18),transparent_22%,transparent_72%,rgba(1,7,14,0.68)),radial-gradient(circle_at_center,transparent_34%,rgba(1,7,14,0.72)_100%)]"
></div>

<!-- Scan-line overlay -->
<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-2
    bg-[linear-gradient(to_bottom,transparent_0,transparent_3px,rgba(172,234,255,0.12)_4px)]
    bg-size-[100%_5px] opacity-[0.08]"
></div>