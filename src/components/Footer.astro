---
import { Icon } from "astro-icon/components";
---

<footer
  id="footer"
  class="relative z-3 mt-16 border-t border-slate-800/60
    bg-[rgba(1,9,17,0.55)] py-8 backdrop-blur-md"
>
  <div class="mx-auto space-y-4 px-4 text-center text-sm text-slate-400">
    <p>© 2026 Kevin "Anthony" Felker</p>

    <div class="flex justify-center gap-6">
      <a
        href="https://github.com/felker12"
        target="_blank"
        rel="noopener noreferrer"
        title="GitHub"
        aria-label="GitHub Profile Link"
        class="text-slate-400 transition-all duration-200
          hover:scale-110 hover:text-cyan-400"
      >
        <Icon name="mdi:github" class="h-6 w-6" />
      </a>

      <a
        href="https://www.linkedin.com/in/anthonyfelker/"
        target="_blank"
        rel="noopener noreferrer"
        title="LinkedIn"
        aria-label="LinkedIn Profile"
        class="text-slate-400 transition-all duration-200
          hover:scale-110 hover:text-cyan-400"
      >
        <Icon name="mdi:linkedin" class="h-6 w-6" />
      </a>

      <a
        href="/contact"
        title="Contact"
        aria-label="Contact Page"
        class="text-slate-400 transition-all duration-200
          hover:scale-110 hover:text-cyan-400"
      >
        <Icon name="mdi:email-outline" class="h-6 w-6" />
      </a>

      <a
        href="/Resume.pdf"
        download="Anthony-Felker-Resume.pdf"
        title="Download Resume"
        aria-label="Download Resume"
        class="text-slate-400 transition-all duration-200
          hover:scale-110 hover:text-cyan-400"
      >
        <Icon name="mdi:file-download-outline" class="h-6 w-6" />
      </a>
    </div>
  </div>
</footer>