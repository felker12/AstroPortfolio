---
import NavItem from "./NavItem.astro";
import ProjectDropdown from "./ProjectDropdown.astro";
import Logo from "./Logo.astro";
import { navLinks } from "@data/navbar/nav";

const pathname = Astro.url.pathname;
---

<header
  class="fixed inset-x-0 top-0 z-20
    border-b border-transparent
    bg-[linear-gradient(180deg,rgba(1,8,16,0.88),rgba(1,8,16,0))]
    transition-[background,backdrop-filter,border-color,box-shadow] duration-200
    [&.is-scrolled]:border-ice-100/10
    [&.is-scrolled]:bg-[rgba(1,9,17,0.78)]
    [&.is-scrolled]:shadow-[0_8px_32px_rgba(0,0,0,0.18)]
    [&.is-scrolled]:backdrop-blur-xl"
>
  <nav
    aria-label="Primary navigation"
    class="mx-auto flex min-h-18 w-full max-w-375
      items-center justify-between gap-4
      px-4 py-4 sm:px-6 lg:px-8"
  >
    <!-- Brand -->
    <a
      href="/"
      aria-label="Home: Kevin Anthony Felker Portfolio"
      class="group flex items-center gap-3 no-underline"
    >
      <Logo />

      <span
        class="whitespace-nowrap text-[1.05rem] font-medium tracking-wide text-white
          transition-colors duration-200 group-hover:text-cyan-300
          max-sm:text-sm"
      >
        Kevin "Anthony" Felker
      </span>
    </a>

    <!-- Mobile menu toggle -->
    <input
      type="checkbox"
      id="menu-toggle"
      class="peer sr-only"
      aria-label="Toggle navigation menu"
      aria-controls="primary-navigation-links"
      aria-expanded="false"
    />

    <label
      for="menu-toggle"
      aria-label="Toggle navigation menu"
      class="relative z-30 flex cursor-pointer flex-col gap-1.5 md:hidden
        peer-checked:[&>span:nth-child(1)]:translate-y-2
        peer-checked:[&>span:nth-child(1)]:rotate-45
        peer-checked:[&>span:nth-child(2)]:opacity-0
        peer-checked:[&>span:nth-child(3)]:-translate-y-2
        peer-checked:[&>span:nth-child(3)]:-rotate-45"
    >
      <span class="h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="h-0.5 w-6 bg-white transition-all duration-300"></span>
      <span class="h-0.5 w-6 bg-white transition-all duration-300"></span>
    </label>

    <!-- Navigation links -->
    <ul
      id="primary-navigation-links"
      class="absolute inset-x-0 top-full flex max-h-0 w-full flex-col
        overflow-hidden border-b border-transparent
        bg-[rgba(1,9,17,0.94)] p-0 opacity-0 backdrop-blur-xl
        transition-[max-height,opacity,padding,border-color] duration-300 ease-in-out
        peer-checked:max-h-128
        peer-checked:border-ice-100/10
        peer-checked:py-4
        peer-checked:opacity-100
        md:static md:flex md:w-auto md:max-h-none md:flex-row md:items-center
        md:gap-6 md:overflow-visible md:border-0 md:bg-transparent
        md:p-0 md:opacity-100 md:backdrop-blur-none"
    >
      {
        navLinks.map((link) => {
          const isActive =
            link.href === "/"
              ? pathname === "/"
              : pathname.startsWith(link.href);

          const hasChildren = (link.children?.length ?? 0) > 0;
          const isContact = link.href === "/contact";

          return (
            <li class="group relative px-4 py-2 md:p-0">
              {isContact ? (
                <a
                  href={link.href}
                  aria-label={link.ariaLabel}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    `relative inline-flex items-center justify-center gap-2
                    overflow-hidden rounded-lg border px-4 py-2.5
                    font-mono text-xs tracking-wide no-underline
                    backdrop-blur-md transition-all duration-150
                    before:h-1.5 before:w-1.5 before:shrink-0
                    before:rounded-full before:bg-ice-400
                    before:shadow-[0_0_12px_rgba(67,199,255,0.9)]
                    hover:-translate-y-px
                    hover:border-ice-300/60
                    hover:bg-[rgba(11,63,96,0.6)]
                    hover:text-ice-50
                    hover:shadow-[0_0_32px_rgba(42,178,255,0.2)]
                    focus-visible:outline-none
                    focus-visible:ring-2
                    focus-visible:ring-ice-400
                    focus-visible:ring-offset-2
                    focus-visible:ring-offset-slate-950
                    md:w-auto`,
                    isActive
                      ? `border-ice-300/60 bg-[rgba(11,63,96,0.6)]
                        text-ice-50 shadow-[0_0_24px_rgba(42,178,255,0.16)]`
                      : `border-ice-100/20 bg-[rgba(5,28,46,0.42)]
                        text-ice-200`,
                  ]}
                >
                  {link.label}
                </a>
              ) : (
                <NavItem {...link} isActive={isActive} />
              )}

              {hasChildren && (
                <ProjectDropdown
                  pathname={pathname}
                  projectLinks={link.children ?? []}
                />
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const nav = document.querySelector("header");

  const updateNavbar = () => {
    nav?.classList.toggle("is-scrolled", window.scrollY > 16);
  };

  updateNavbar();
  window.addEventListener("scroll", updateNavbar, {
    passive: true,
  });

  const menuToggle = document.querySelector<HTMLInputElement>("#menu-toggle");

  const navLinks = document.querySelectorAll<HTMLAnchorElement>("header nav a");

  const updateMenuState = () => {
    if (!menuToggle) return;

    menuToggle.setAttribute("aria-expanded", String(menuToggle.checked));
  };

  menuToggle?.addEventListener("change", updateMenuState);
  updateMenuState();

  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (!menuToggle) return;

      menuToggle.checked = false;
      updateMenuState();
    });
  });
</script>
