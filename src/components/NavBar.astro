---
import NavItem from "./NavItem.astro";
import ProjectDropdown from "./ProjectDropdown.astro";

const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home", ariaLabel: "Home – Kevin Anthony Felker Portfolio" },
  { href: "/about", label: "About", ariaLabel: "About Kevin Anthony Felker" },
  { href: "/projects", label: "Projects", ariaLabel: "Software Development Projects", hasDropdown: true },
  { href: "/skills", label: "Skills", ariaLabel: "Technical Skills" },
  { href: "/contact", label: "Contact", ariaLabel: "Contact Kevin Anthony Felker" },
];

const projectLinks = [
  { href: "/projects/portfolio-generator", label: "Portfolio Generator", ariaLabel: "Portfolio Generator Case Study" },
  { href: "/projects/time-punch", label: "Time Punch", ariaLabel: "Time Punch Management System Case Study" },
  { href: "/projects/rpg-engine", label: "RPG Engine", ariaLabel: "Modular 2D RPG Engine Case Study" },
  { href: "/projects/legacy-portfolio", label: "Legacy Portfolio", ariaLabel: "Legacy ASP.NET Portfolio Case Study" },
];
---

<header class="bg-black/50 backdrop-blur-md text-slate-200 font-sans border-b border-slate-800/40 sticky top-0 z-50">
  <nav class="flex flex-wrap items-center justify-between py-4 px-6 max-w-7xl mx-auto" aria-label="Primary navigation">
    <div class="text-[1.1rem] font-medium tracking-wide">
      <a
        href="/"
        aria-label="Home – Kevin Anthony Felker Portfolio"
        class="text-white hover:text-cyan-400 transition-colors duration-200 no-underline"
      >
        Kevin "Anthony" Felker
      </a>
    </div>

    <input type="checkbox" id="menu-toggle" class="peer hidden" />

    <label
      for="menu-toggle"
      aria-label="Toggle navigation menu"
      class="flex flex-col gap-1.5 cursor-pointer md:hidden
      peer-checked:[&>span:nth-child(1)]:translate-y-2 peer-checked:[&>span:nth-child(1)]:rotate-45
      peer-checked:[&>span:nth-child(2)]:opacity-0
      peer-checked:[&>span:nth-child(3)]:-translate-y-2 peer-checked:[&>span:nth-child(3)]:-rotate-45"
    >
      <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
    </label>

    <ul
      class="flex flex-col w-full list-none m-0 p-0 max-h-0 opacity-0 overflow-hidden
      transition-all duration-400 ease-in-out
      peer-checked:max-h-120 peer-checked:opacity-100 peer-checked:py-4
      md:flex md:flex-row md:w-auto md:max-h-none md:opacity-100 md:overflow-visible md:gap-6 md:p-0"
    >
      {navLinks.map((link) => {
        const isActive = link.href === "/"
          ? pathname === "/"
          : pathname.startsWith(link.href);

        return (
          <li class="relative group py-2 px-4 md:p-0">
            <NavItem
              href={link.href}
              label={link.label}
              ariaLabel={link.ariaLabel}
              isActive={isActive}
              hasDropdown={link.hasDropdown}
            />

            {link.hasDropdown && (
              <ProjectDropdown pathname={pathname} projectLinks={projectLinks} />
            )}
          </li>
        );
      })}
    </ul>
  </nav>
</header>